{
  "name": "broadcast",
  "private": true,
  "description": "Broadcast multi-tenant com React, Firebase e Cloud Functions",
  "scripts": {
    "emulators": "npm run build --prefix functions && firebase emulators:start --project demo-broadcast",
    "test:rules": "firebase emulators:exec --only firestore --project demo-broadcast \"vitest run\"",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^5.0.3"
  }
}
