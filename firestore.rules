rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasExactly(fields) {
      return request.resource.data.keys().hasAll(fields)
        && request.resource.data.keys().hasOnly(fields);
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOwner(data) {
      return isSignedIn() && data.clientId == request.auth.uid;
    }

    function ownsConnection(connectionId) {
      return get(/databases/$(database)/documents/connections/$(connectionId)).data.clientId
        == request.auth.uid;
    }

    function isNew() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /clients/{clientId} {
      allow read: if isSignedIn() && request.auth.uid == clientId;

      allow create: if isSignedIn()
        && request.auth.uid == clientId
        && hasExactly(['name', 'email', 'createdAt'])
        && isText(request.resource.data.name, 2, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
    }

    match /connections/{connectionId} {
      allow read: if isOwner(resource.data);

      allow create: if isOwner(request.resource.data)
        && hasExactly(['clientId', 'name', 'createdAt', 'updatedAt'])
        && isText(request.resource.data.name, 1, 60)
        && isNew();

      allow update: if isOwner(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && isText(request.resource.data.name, 1, 60)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(resource.data);
    }

    function isValidContact(data) {
      return isText(data.name, 1, 80)
        && data.phone is string
        && data.phone.matches('^[0-9]{10,11}$');
    }

    match /contacts/{contactId} {
      allow read: if isOwner(resource.data);

      allow create: if isOwner(request.resource.data)
        && hasExactly(['clientId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'])
        && isValidContact(request.resource.data)
        && ownsConnection(request.resource.data.connectionId)
        && isNew();

      allow update: if isOwner(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])
        && isValidContact(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(resource.data);
    }

    function isValidMessage(data) {
      return isText(data.content, 1, 1000)
        && data.contactIds is list
        && data.contactIds.size() > 0
        && data.contactIds.size() <= 500
        && (
          (data.status == 'sent' && data.sentAt == request.time && data.scheduledAt == null)
          || (data.status == 'scheduled'
            && data.scheduledAt is timestamp
            && data.scheduledAt > request.time
            && data.sentAt == null)
        );
    }

    match /messages/{messageId} {
      allow read: if isOwner(resource.data);

      allow create: if isOwner(request.resource.data)
        && hasExactly([
          'clientId', 'connectionId', 'contactIds', 'content', 'status',
          'scheduledAt', 'sentAt', 'createdAt', 'updatedAt'
        ])
        && isValidMessage(request.resource.data)
        && ownsConnection(request.resource.data.connectionId)
        && isNew();

      allow update: if isOwner(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['contactIds', 'content', 'status', 'scheduledAt', 'sentAt', 'updatedAt'])
        && isValidMessage(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(resource.data);
    }
  }
}
