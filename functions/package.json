{
  "name": "broadcast-functions",
  "private": true,
  "description": "Cloud Functions do Broadcast",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "firebase emulators:exec --only firestore --project demo-broadcast \"vitest run\"",
    "test:watch": "firebase emulators:exec --only firestore --project demo-broadcast \"vitest\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore --project demo-broadcast",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
